# Saathi environment. Copy to .env.local for development.
# Values are added as each part lands; see the build plan.

# Public URL of this deployment, e.g. https://saathi-ten.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project. Local values come from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# GitHub sign-in on a local Supabase. Export these before `npx supabase start`.
# For the stand-in GitHub that e2e uses, run `node tests/e2e/github-mock.ts` and set the URL to
# http://<docker bridge gateway>:54399 (172.17.0.1 on most Linux hosts). For real GitHub, leave the URL empty.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=mock
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=mock
SUPABASE_AUTH_EXTERNAL_GITHUB_URL=http://172.17.0.1:54399

# Server only, for POST /mcp: the agent functions are granted to service_role. Never expose it to the browser.
SUPABASE_SECRET_KEY=
